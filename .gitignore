.DS_Store
.build/
.swiftpm/
DerivedData/
apple/*.xcodeproj/
*.xcresult
*.xcuserstate
xcuserdata/
*.p12
*.p8
*.mobileprovision

# Secrets: Home Assistant tokens and credentials never enter the repo.
*.env
.env
.env.*
!.env.example
apple/Apps/*/Info.plist
# Generated by xcodegen from project.yml `entitlements.properties`.
apple/Apps/*/*.entitlements
.build/

# Local build output (xcodebuild -derivedDataPath, result bundles).
build/

# Design skills installed locally by tools/install_design_skills.sh. app-designer-pro is a paid skill and this
# repo is public, so neither copy is committed.
.claude/skills/apple-hig/
.claude/skills/app-designer-pro/
.claude/commands/duo.md

# Review screenshots are never committed (owner, 2026-10-13; .agents/testing/apple/devices.md).
screenshots/

# LLVM coverage output
*.profraw

# BSD sed -i backups
*-E

# Private journey expectations (the owner's real house values; the tracked file is the .template.json). Keep the copy
# outside the repository; these names are a safety net if one lands inside. See .agents/testing/apple/journey-expectations.md.
**/JourneyExpectations.json
**/JourneyExpectations.local.json
*.private.json
*.expectations.json
