#!/bin/sh
# Refuse a push whose new commits match the private house denylist (tools/prepush_denylist.py).
# Git passes "<remote name> <url>" as arguments and "<local ref> <local sha> <remote ref> <remote sha>" lines on stdin.
# Push, then review (owner, 2026-11-10): no reviewer pass is needed to push; the merge gate (pr-checks and ai-review on the exact head) is on GitHub.
# Install with tools/setup.sh. See .agents/workflow/house-data-gate.md.
root="$(cd "$(dirname "$0")/.." && pwd)" || exit 1
command -v python3 >/dev/null 2>&1 || { echo "pre-push: python3 not found; refusing the push." >&2; exit 1; }
refs="$(mktemp)" || exit 1
trap 'rm -f "$refs"' EXIT
cat > "$refs"
# A push to main or master of SFenton/native-home is refused locally (the ruleset refuses it too; this is the friendly message). Deleting included.
case "$2" in
  *[Ss][Ff]enton/[Nn]ative-home*)
    if awk '$3 == "refs/heads/main" || $3 == "refs/heads/master" { found = 1 } END { exit !found }' "$refs"; then
      echo "pre-push: refusing a push to main or master of SFenton/native-home; open a pull request from a branch instead." >&2
      exit 1
    fi ;;
esac
# The rule surface stays clean: forbidden patterns, budgets, one home, links (tools/rules_lint.py; budgets in contracts/rules-surface.json).
python3 "$root/tools/prepush_denylist.py" "$@" < "$refs" || exit $?
if git -C "$root" rev-parse --verify -q origin/main >/dev/null 2>&1; then
  python3 "$root/tools/rules_lint.py" --base origin/main || exit 1
else
  python3 "$root/tools/rules_lint.py" || exit 1
fi
