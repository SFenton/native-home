    {
      "id": "garage-door",
      "name": "Garage door",
      "domain": "cover",
      "actionId": "door",
      "togglesDisc": true,
      "rules": [
        {
          "states": [
            "closed"
          ],
          "class": "resting",
          "active": false,
          "action": {
            "verb": "Open",
            "icon": "door.garage.closed",
            "service": "open_cover"
          }
        },
        {
          "states": [
            "open"
          ],
          "class": "resting",
          "active": true,
          "action": {
            "verb": "Close",
            "icon": "door.garage.open",
            "service": "close_cover"
          }
        },
        {
          "states": [
            "opening"
          ],
          "class": "in-progress",
          "active": true,
          "action": {
            "verb": "Stop",
            "icon": "stop.fill",
            "service": "stop_cover",
            "requiresFeature": 8,
            "otherwise": {
              "verb": "Reverse",
              "icon": "arrow.uturn.down",
              "service": "close_cover"
            }
          }
        },
        {
          "states": [
            "closing"
          ],
          "class": "in-progress",
          "active": true,
          "action": {
            "verb": "Stop",
            "icon": "stop.fill",
            "service": "stop_cover",
            "requiresFeature": 8,
            "otherwise": {
              "verb": "Reverse",
              "icon": "arrow.uturn.up",
              "service": "open_cover"
            }
          }
        },
        {
          "states": [
            "unavailable",
            "unknown"
          ],
          "class": "unknown",
          "active": false,
          "icon": "door.garage.closed",
          "action": {
            "verb": "Open",
            "icon": "door.garage.closed",
            "tappable": false
          }
        }
      ],
      "fallback": {
        "class": "unknown",
        "active": false,
        "icon": "door.garage.closed",
        "action": {
          "verb": "Open",
          "icon": "door.garage.closed",
          "tappable": false
        }
      },
      "request": {
        "lockoutSeconds": 2,
        "ackTimeoutSeconds": 10,
        "settleTimeoutSeconds": 45,
        "errorHoldSeconds": 8,
        "onTimeout": "error",
        "pendingWords": [
          {
            "service": "close_cover",
            "text": "Sending Close…"
          },
          {
            "service": "open_cover",
