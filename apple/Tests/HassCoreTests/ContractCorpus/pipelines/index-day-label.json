{
  "format": 1,
  "name": "index-day-label",
  "note": "The first day reads Today, the others their weekday; a day with no date reads Day and its number (WeatherFormat.swift:81-85).",
  "response": [
    {
      "at": "2026-11-15T00:00:00"
    },
    {
      "at": "2026-11-16T00:00:00"
    },
    {
      "at": null
    },
    {
      "at": "2026-11-18T00:00:00"
    }
  ],
  "compiles": true,
  "context": {
    "clock": {
      "now": "2026-11-15T09:30:00",
      "utcOffsetMinutes": -480
    }
  },
  "inputs": {
    "title": "Case",
    "parameters": [],
    "request": {
      "type": "entity-attribute",
      "entityId": {
        "type": "literal",
        "value": "sensor.demo_case"
      },
      "path": [
        "value"
      ],
      "responseShape": {
        "kind": "array",
        "of": {
          "kind": "object",
          "fields": {
            "at": {
              "shape": {
                "kind": "union",
                "of": [
                  {
                    "kind": "null"
                  },
                  {
                    "kind": "string",
                    "format": "date-time"
                  }
                ]
              }
            }
          }
        }
      }
    },
    "steps": [
      {
        "id": "labels",
        "op": "map",
        "fields": {
          "label": {
            "type": "choose",
            "cases": [
              {
                "when": {
                  "type": "compare",
                  "op": "eq",
                  "left": {
                    "type": "index"
                  },
                  "right": {
                    "type": "literal",
                    "value": 0
                  }
                },
                "then": {
                  "type": "literal",
                  "value": "Today"
                }
              },
              {
                "when": {
                  "type": "exists",
                  "value": {
                    "type": "item",
                    "path": [
                      "at"
                    ]
                  }
                },
                "then": {
                  "type": "format",
                  "pattern": "{d}",
                  "args": {
                    "d": {
                      "type": "item",
                      "path": [
                        "at"
                      ]
                    }
                  },
                  "formats": {
                    "d": {
                      "date": {
                        "style": "weekday"
                      }
                    }
                  }
                }
              }
            ],
            "otherwise": {
              "type": "format",
              "pattern": "Day {n}",
              "args": {
                "n": {
                  "type": "math",
                  "op": "add",
                  "args": [
                    {
                      "type": "index"
                    },
                    {
                      "type": "literal",
                      "value": 1
                    }
                  ]
                }
              }
            }
          }
        }
      }
    ],
    "output": {
      "kind": "records",
      "max": 7
    },
    "schema": {
      "kind": "array",
      "of": {
        "kind": "object",
        "fields": {
          "label": {
            "shape": {
              "kind": "union",
              "of": [
                {
                  "kind": "null"
                },
                {
                  "kind": "string"
                }
              ]
            }
          }
        }
      }
    },
    "refresh": {
      "on": [
        "open"
      ],
      "staleAfterSeconds": 300
    }
  },
  "expected": {
    "status": "ok",
    "output": [
      {
        "label": "Today"
      },
      {
        "label": "Mon"
      },
      {
        "label": "Day 3"
      },
      {
        "label": "Wed"
      }
    ]
  }
}
