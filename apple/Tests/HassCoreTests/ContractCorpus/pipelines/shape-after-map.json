{
  "format": 1,
  "name": "shape-after-map",
  "note": "The shape after a map is the object the fields build: an optional source field becomes a nullable one, a date measure a nullable integer.",
  "inputs": {
    "title": "Case",
    "parameters": [],
    "request": {
      "type": "entity-attribute",
      "entityId": {
        "type": "literal",
        "value": "sensor.demo_case"
      },
      "path": [
        "value"
      ],
      "responseShape": {
        "kind": "array",
        "of": {
          "kind": "object",
          "fields": {
            "due": {
              "shape": {
                "kind": "string",
                "format": "date"
              },
              "optional": true
            },
            "summary": {
              "shape": {
                "kind": "string",
                "enum": [
                  "Sweep",
                  "Water plants"
                ]
              }
            },
            "uid": {
              "shape": {
                "kind": "string",
                "enum": [
                  "u1",
                  "u2"
                ]
              }
            }
          }
        }
      }
    },
    "steps": [
      {
        "id": "m",
        "op": "map",
        "fields": {
          "id": {
            "type": "item",
            "path": [
              "uid"
            ]
          },
          "name": {
            "type": "item",
            "path": [
              "summary"
            ]
          },
          "late": {
            "type": "date",
            "op": "days-between",
            "from": {
              "type": "item",
              "path": [
                "due"
              ]
            },
            "to": {
              "type": "clock",
              "part": "today"
            }
          }
        }
      }
    ],
    "output": {
      "kind": "rows",
      "max": 10,
      "row": {
        "id": {
          "type": "item",
          "path": [
            "id"
          ]
        },
        "title": {
          "type": "item",
          "path": [
            "name"
          ]
        }
      }
    },
    "schema": {
      "kind": "array",
      "of": {
        "kind": "object",
        "fields": {
          "id": {
            "shape": {
              "kind": "string",
              "enum": [
                "u1",
                "u2"
              ]
            }
          },
          "late": {
            "shape": {
              "kind": "union",
              "of": [
                {
                  "kind": "null"
                },
                {
                  "kind": "number",
                  "integer": true
                }
              ]
            }
          },
          "name": {
            "shape": {
              "kind": "string",
              "enum": [
                "Sweep",
                "Water plants"
              ]
            }
          }
        }
      }
    },
    "refresh": {
      "on": [
        "open"
      ],
      "staleAfterSeconds": 300
    }
  },
  "response": [
    {
      "uid": "u1",
      "summary": "Water plants",
      "due": "2026-11-10"
    },
    {
      "uid": "u2",
      "summary": "Sweep"
    }
  ],
  "context": {
    "clock": {
      "now": "2026-11-15T09:30:00",
      "utcOffsetMinutes": -480
    }
  },
  "expected": {
    "status": "ok",
    "output": [
      {
        "id": "u1",
        "title": "Water plants"
      },
      {
        "id": "u2",
        "title": "Sweep"
      }
    ]
  },
  "compiles": true,
  "expectedShape": {
    "kind": "array",
    "of": {
      "kind": "object",
      "fields": {
        "id": {
          "shape": {
            "kind": "string",
            "enum": [
              "u1",
              "u2"
            ]
          }
        },
        "name": {
          "shape": {
            "kind": "string",
            "enum": [
              "Sweep",
              "Water plants"
            ]
          }
        },
        "late": {
          "shape": {
            "kind": "union",
            "of": [
              {
                "kind": "null"
              },
              {
                "kind": "number",
                "integer": true
              }
            ]
          }
        }
      }
    }
  }
}
