{
  "format": 1,
  "name": "dialctl-move-stops-at-the-other",
  "note": "The low handle dragged to 78 stops at the high one, 75, and says it stopped.",
  "subject": {
    "dialctl": {
      "op": "move",
      "input": {
        "range": {
          "min": 60,
          "max": 80,
          "step": 0.5
        },
        "stoppers": [
          {
            "id": "low",
            "value": 68
          },
          {
            "id": "high",
            "value": 75
          }
        ],
        "between": {
          "rule": "stop"
        }
      },
      "id": "low",
      "raw": 78
    }
  },
  "env": {},
  "expected": {
    "dialctl": {
      "move": {
        "value": 75,
        "stopped": true
      }
    }
  }
}
