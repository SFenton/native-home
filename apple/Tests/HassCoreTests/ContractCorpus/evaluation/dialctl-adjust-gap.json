{
  "format": 1,
  "name": "dialctl-adjust-gap",
  "note": "With a gap of 5 the low handle at 64.5 goes up one step to 65 and no further.",
  "subject": {
    "dialctl": {
      "op": "adjust",
      "input": {
        "range": {
          "min": 0,
          "max": 100,
          "step": 0.5
        },
        "stoppers": [
          {
            "id": "low",
            "value": 64.5
          },
          {
            "id": "high",
            "value": 70
          }
        ],
        "between": {
          "rule": "stop",
          "gap": 5
        }
      },
      "id": "low",
      "direction": 1
    }
  },
  "env": {},
  "expected": {
    "dialctl": {
      "value": 65
    }
  }
}
