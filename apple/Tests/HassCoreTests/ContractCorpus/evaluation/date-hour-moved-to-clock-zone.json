{
  "format": 1,
  "name": "date-hour-moved-to-clock-zone",
  "note": "A time with an offset is moved to the clock's zone: 03:41 UTC is 7:41 PM at -08:00, shown 7 PM.",
  "subject": {
    "operand": {
      "type": "format",
      "pattern": "{d}",
      "args": {
        "d": {
          "type": "literal",
          "value": "2026-11-13T03:41:00Z"
        }
      },
      "formats": {
        "d": {
          "date": {
            "style": "hour"
          }
        }
      }
    }
  },
  "env": {
    "locale": "en_US",
    "clock": {
      "now": "2026-11-15T09:30:00",
      "utcOffsetMinutes": -480
    }
  },
  "expected": {
    "status": "value",
    "value": "7 PM"
  }
}
