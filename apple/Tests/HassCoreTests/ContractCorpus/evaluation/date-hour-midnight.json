      "type": "format",
      "pattern": "{d}",
      "args": {
        "d": {
          "type": "literal",
          "value": "2026-11-12T00:00:00"
        }
      },
      "formats": {
        "d": {
          "date": {
            "style": "hour"
          }
        }
      }
    }
  },
  "env": {
    "locale": "en_US",
    "clock": {
      "now": "2026-11-15T09:30:00",
