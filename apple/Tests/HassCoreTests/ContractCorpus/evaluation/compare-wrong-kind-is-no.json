{
  "format": 1,
  "name": "compare-wrong-kind-is-no",
  "note": "A value of the wrong kind is a value: no, not unknown.",
  "subject": {
    "condition": {
      "type": "compare",
      "op": "above",
      "left": {
        "type": "read",
        "from": {
          "type": "source",
          "sourceId": "temp",
          "path": [
            "state"
          ]
        },
        "as": "string",
        "missing": "unavailable"
      },
      "right": {
        "type": "literal",
        "value": 60
      }
    }
  },
  "env": {
    "reads": {
      "temp/state": {
        "status": "value",
        "value": "warm"
      }
    }
  },
  "expected": {
    "tri": "no"
  }
}
