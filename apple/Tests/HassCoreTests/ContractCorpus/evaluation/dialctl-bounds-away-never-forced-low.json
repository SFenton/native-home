{
  "format": 1,
  "name": "dialctl-bounds-away-never-forced-low",
  "note": "Reported 68 and 70 with a gap of 5 are closer than the gap: they are drawn as they are. The low handle may stay at 68 or go down, never up.",
  "subject": {
    "dialctl": {
      "op": "bounds",
      "input": {
        "range": {
          "min": 0,
          "max": 100,
          "step": 1
        },
        "stoppers": [
          {
            "id": "low",
            "value": 68
          },
          {
            "id": "high",
            "value": 70
          }
        ],
        "between": {
          "rule": "stop",
          "gap": 5
        }
      },
      "id": "low"
    }
  },
  "env": {},
  "expected": {
    "dialctl": {
      "bounds": {
        "lower": 0,
        "upper": 68,
        "lowerMark": null,
        "upperMark": 68
      }
    }
  }
}
