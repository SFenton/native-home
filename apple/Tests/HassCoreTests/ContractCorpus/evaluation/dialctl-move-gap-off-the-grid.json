{
  "format": 1,
  "name": "dialctl-move-gap-off-the-grid",
  "note": "A stop that falls between grid values gives the one inside it: a gap of 3 on a grid of 5 holds the low handle at 47, so 45.",
  "subject": {
    "dialctl": {
      "op": "move",
      "input": {
        "range": {
          "min": 0,
          "max": 100,
          "step": 5
        },
        "stoppers": [
          {
            "id": "low",
            "value": 10
          },
          {
            "id": "high",
            "value": 50
          }
        ],
        "between": {
          "rule": "stop",
          "gap": 3
        }
      },
      "id": "low",
      "raw": 100
    }
  },
  "env": {},
  "expected": {
    "dialctl": {
      "move": {
        "value": 45,
        "stopped": true
      }
    }
  }
}
