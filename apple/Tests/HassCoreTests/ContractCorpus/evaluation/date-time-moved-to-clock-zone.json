{
  "format": 1,
  "name": "date-time-moved-to-clock-zone",
  "note": "A time with an offset is moved to the clock's: 17:41 UTC is 9:41 AM at -08:00.",
  "subject": {
    "operand": {
      "type": "format",
      "pattern": "{d}",
      "args": {
        "d": {
          "type": "literal",
          "value": "2026-11-12T17:41:00Z"
        }
      },
      "formats": {
        "d": {
          "date": {
            "style": "time"
          }
        }
      }
    }
  },
  "env": {
    "locale": "en_US",
    "clock": {
      "now": "2026-11-15T09:30:00",
      "utcOffsetMinutes": -480
    }
  },
  "expected": {
    "status": "value",
    "value": "9:41 AM"
  }
}
