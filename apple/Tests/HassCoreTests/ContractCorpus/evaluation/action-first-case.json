{
  "format": 1,
  "name": "action-first-case",
  "note": "The first case that holds runs its action.",
  "subject": {
    "action": {
      "type": "conditional",
      "cases": [
        {
          "when": {
            "type": "compare",
            "op": "above",
            "left": {
              "type": "read",
              "from": {
                "type": "source",
                "sourceId": "temp",
                "path": [
                  "state"
                ]
              },
              "as": "number",
              "missing": "unavailable"
            },
            "right": {
              "type": "literal",
              "value": 75
            }
          },
          "then": {
            "type": "push",
            "pageId": "page-lattice",
            "arguments": {},
            "origin": "sender",
            "duplicate": "reuse-nearest"
          }
        },
        {
          "when": {
            "type": "compare",
            "op": "below",
            "left": {
              "type": "read",
              "from": {
                "type": "source",
                "sourceId": "temp",
                "path": [
                  "state"
                ]
              },
              "as": "number",
              "missing": "unavailable"
            },
            "right": {
              "type": "literal",
              "value": 60
            }
          },
          "then": {
            "type": "call-service",
            "domain": "light",
            "service": "turn_on",
            "target": {
              "entity_id": {
                "type": "literal",
                "value": "light.demo_lamp"
              }
            }
          }
        }
      ],
      "otherwise": {
        "type": "none"
      }
    }
  },
  "env": {
    "reads": {
      "temp/state": {
        "status": "value",
        "value": "80"
      }
    }
  },
  "expected": {
    "pick": 0,
    "runs": "push"
  }
}
