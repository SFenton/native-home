{
  "format": 1,
  "name": "list-includes-loading-beats-unavailable",
  "note": "loading is reported before unavailable.",
  "subject": {
    "operand": {
      "type": "list-includes",
      "from": {
        "type": "source",
        "sourceId": "hvac",
        "path": [
          "attributes",
          "hvac_modes"
        ]
      },
      "value": {
        "type": "read",
        "from": {
          "type": "source",
          "sourceId": "want",
          "path": [
            "state"
          ]
        },
        "as": "string",
        "missing": "unavailable"
      }
    }
  },
  "env": {
    "reads": {
      "hvac/attributes/hvac_modes": {
        "status": "loading"
      }
    }
  },
  "expected": {
    "status": "loading"
  }
}
