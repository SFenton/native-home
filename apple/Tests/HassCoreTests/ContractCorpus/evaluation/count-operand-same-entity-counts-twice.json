{
  "format": 1,
  "name": "count-operand-same-entity-counts-twice",
  "note": "Entries stand on their own: the same entity listed twice counts twice.",
  "subject": {
    "operand": {
      "type": "count",
      "of": [
        {
          "test": {
            "type": "state",
            "sourceId": "a",
            "path": [
              "state"
            ],
            "in": [
              "on"
            ]
          }
        },
        {
          "test": {
            "type": "state",
            "sourceId": "a",
            "path": [
              "state"
            ],
            "in": [
              "on"
            ]
          }
        }
      ]
    }
  },
  "env": {
    "reads": {
      "a/state": {
        "status": "value",
        "value": "on"
      }
    }
  },
  "expected": {
    "status": "value",
    "value": 2
  }
}
