{
  "format": 1,
  "name": "count-operand-badge-last-changed-loading-keeps",
  "note": "A count over last-change times still loading keeps the badge's last text.",
  "subject": {
    "badge": {
      "type": "value",
      "value": {
        "type": "count",
        "of": [
          {
            "test": {
              "type": "compare",
              "op": "after",
              "left": {
                "type": "last-changed",
                "sourceId": "a"
              },
              "right": {
                "type": "literal",
                "value": "2026-01-01T00:00:00Z"
              }
            }
          },
          {
            "test": {
              "type": "compare",
              "op": "after",
              "left": {
                "type": "last-changed",
                "sourceId": "b"
              },
              "right": {
                "type": "literal",
                "value": "2026-01-01T00:00:00Z"
              }
            }
          }
        ]
      }
    }
  },
  "env": {
    "changed": {
      "a": {
        "status": "loading"
      },
      "b": {
        "status": "loading"
      }
    }
  },
  "expected": {
    "status": "loading"
  }
}
