{
  "format": 1,
  "name": "count-operand-line-unanswerable-is-loading",
  "note": "A count with nothing to say stops the rule: the line keeps what it showed rather than drawing \"All closed\".",
  "subject": {
    "operand": {
      "type": "choose",
      "cases": [
        {
          "when": {
            "type": "compare",
            "op": "eq",
            "left": {
              "type": "count",
              "of": [
                {
                  "test": {
                    "type": "state",
                    "sourceId": "a",
                    "path": [
                      "state"
                    ],
                    "in": [
                      "on"
                    ]
                  }
                },
                {
                  "test": {
                    "type": "state",
                    "sourceId": "b",
                    "path": [
                      "state"
                    ],
                    "in": [
                      "on"
                    ]
                  }
                },
                {
                  "test": {
                    "type": "state",
                    "sourceId": "c",
                    "path": [
                      "state"
                    ],
                    "in": [
                      "on"
                    ]
                  }
                }
              ]
            },
            "right": {
              "type": "literal",
              "value": 0
