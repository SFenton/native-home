                        "state"
                      ],
                      "in": [
                        "on"
                      ]
                    }
                  },
                  {
                    "test": {
                      "type": "state",
                      "sourceId": "c",
                      "path": [
                        "state"
                      ],
                      "in": [
                        "on"
                      ]
                    }
                  }
                ]
              }
            }
          }
        }
      ],
      "otherwise": {
        "type": "literal",
        "value": "One open"
      }
