                    "path": [
                      "state"
                    ],
                    "in": [
                      "on"
                    ]
                  }
                },
                {
                  "test": {
                    "type": "state",
                    "sourceId": "b",
                    "path": [
                      "state"
                    ],
                    "in": [
                      "on"
                    ]
                  }
                },
                {
                  "test": {
                    "type": "state",
                    "sourceId": "c",
                    "path": [
                      "state"
                    ],
                    "in": [
                      "on"
                    ]
                  }
                }
              ]
            },
            "right": {
              "type": "literal",
              "value": 1
            }
          },
          "then": {
            "type": "format",
            "pattern": "{n} open",
            "args": {
              "n": {
                "type": "count",
