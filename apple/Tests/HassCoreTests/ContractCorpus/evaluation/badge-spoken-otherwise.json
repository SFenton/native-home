{
  "format": 1,
  "name": "badge-spoken-otherwise",
  "note": "Any other count uses the Otherwise line.",
  "subject": {
    "badge": {
      "type": "value",
      "value": {
        "type": "read",
        "from": {
          "type": "source",
          "sourceId": "temp",
          "path": [
            "state"
          ]
        },
        "as": "number",
        "missing": "unavailable"
      },
      "spoken": {
        "type": "choose",
        "cases": [
          {
            "when": {
              "type": "compare",
              "op": "eq",
              "left": {
                "type": "read",
                "from": {
                  "type": "source",
                  "sourceId": "temp",
                  "path": [
                    "state"
                  ]
                },
                "as": "number",
                "missing": "unavailable"
              },
              "right": {
                "type": "literal",
                "value": 1
              }
            },
            "then": {
              "type": "literal",
              "value": "1 item needs attention"
            }
          }
        ],
        "otherwise": {
          "type": "format",
          "pattern": "{count} items need attention",
          "args": {
            "count": {
              "type": "read",
              "from": {
                "type": "source",
                "sourceId": "temp",
                "path": [
                  "state"
                ]
              },
              "as": "number",
              "missing": "unavailable"
            }
          }
        }
      }
    }
  },
  "env": {
    "reads": {
      "temp/state": {
        "status": "value",
        "value": 2
      }
    }
  },
  "expected": {
    "status": "value",
    "text": "2",
    "spoken": "2 items need attention"
  }
}
