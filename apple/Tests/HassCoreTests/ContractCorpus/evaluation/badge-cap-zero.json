{
  "format": 1,
  "name": "badge-cap-zero",
  "note": "A count of 0 draws no badge, capped or not.",
  "subject": {
    "badge": {
      "type": "value",
      "value": {
        "type": "choose",
        "cases": [
          {
            "when": {
              "type": "compare",
              "op": "above",
              "left": {
                "type": "read",
                "from": {
                  "type": "source",
                  "sourceId": "temp",
                  "path": [
                    "state"
                  ]
                },
                "as": "number",
                "missing": "unavailable"
              },
              "right": {
                "type": "literal",
                "value": 9
              }
            },
            "then": {
              "type": "literal",
              "value": "9+"
            }
          }
        ],
        "otherwise": {
          "type": "format",
          "pattern": "{count}",
          "args": {
            "count": {
              "type": "read",
              "from": {
                "type": "source",
                "sourceId": "temp",
                "path": [
                  "state"
                ]
              },
              "as": "number",
              "missing": "unavailable"
            }
          }
        }
      }
    }
  },
  "env": {
    "reads": {
      "temp/state": {
        "status": "value",
        "value": 0
      }
    }
  },
  "expected": {
    "status": "value",
    "text": null
  }
}
