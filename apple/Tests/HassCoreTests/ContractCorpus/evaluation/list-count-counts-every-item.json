{
  "format": 1,
  "name": "list-count-counts-every-item",
  "note": "Every item counts, whatever it is.",
  "subject": {
    "operand": {
      "type": "list-count",
      "from": {
        "type": "source",
        "sourceId": "hvac",
        "path": [
          "attributes",
          "hvac_modes"
        ]
      }
    }
  },
  "env": {
    "reads": {
      "hvac/attributes/hvac_modes": {
        "status": "value",
        "value": [
          "heat",
          null,
          2
        ]
      }
    }
  },
  "expected": {
    "status": "value",
    "value": 3
  }
}
