{
  "format": 1,
  "name": "index-in-a-rule",
  "note": "The first cell says Now (WeatherFormat.hourLabel, `if index == 0 { return \"Now\" }`, WeatherFormat.swift:89).",
  "subject": {
    "operand": {
      "type": "choose",
      "cases": [
        {
          "when": {
            "type": "compare",
            "op": "eq",
            "left": {
              "type": "index"
            },
            "right": {
              "type": "literal",
              "value": 0
            }
          },
          "then": {
            "type": "literal",
            "value": "Now"
          }
        }
      ],
      "otherwise": {
        "type": "literal",
        "value": "Later"
      }
    }
  },
  "env": {
    "item": {},
    "index": 0
  },
  "expected": {
    "status": "value",
    "value": "Now"
  }
}
