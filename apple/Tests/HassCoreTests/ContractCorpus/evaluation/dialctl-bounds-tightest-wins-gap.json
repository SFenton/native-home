{
  "format": 1,
  "name": "dialctl-bounds-tightest-wins-gap",
  "note": "A highest of 70 is looser than the gap's stop at 65: 65, marked.",
  "subject": {
    "dialctl": {
      "op": "bounds",
      "input": {
        "range": {
          "min": 0,
          "max": 100,
          "step": 1
        },
        "stoppers": [
          {
            "id": "low",
            "value": 30,
            "limit": {
              "max": 70
            }
          },
          {
            "id": "high",
            "value": 70
          }
        ],
        "between": {
          "rule": "stop",
          "gap": 5
        }
      },
      "id": "low"
    }
  },
  "env": {},
  "expected": {
    "dialctl": {
      "bounds": {
        "lower": 0,
        "upper": 65,
        "lowerMark": null,
        "upperMark": 65
      }
    }
  }
}
