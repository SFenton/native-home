{
  "format": 1,
  "name": "date-weekday-moved-to-clock-zone",
  "note": "The weekday is the clock zone's: 03:41 UTC on Friday 13 is still Thu at -08:00.",
  "subject": {
    "operand": {
      "type": "format",
      "pattern": "{d}",
      "args": {
        "d": {
          "type": "literal",
          "value": "2026-11-13T03:41:00Z"
        }
      },
      "formats": {
        "d": {
          "date": {
            "style": "weekday"
          }
        }
      }
    }
  },
  "env": {
    "locale": "en_US",
    "clock": {
      "now": "2026-11-15T09:30:00",
      "utcOffsetMinutes": -480
    }
  },
  "expected": {
    "status": "value",
    "value": "Thu"
  }
}
