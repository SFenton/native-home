{
  "format": 1,
  "name": "badge-spoken-below-cap",
  "note": "Below the cap the drawn text and the count agree.",
  "subject": {
    "badge": {
      "type": "value",
      "value": {
        "type": "choose",
        "cases": [
          {
            "when": {
              "type": "compare",
              "op": "above",
              "left": {
                "type": "read",
                "from": {
                  "type": "source",
                  "sourceId": "temp",
                  "path": [
                    "state"
                  ]
                },
                "as": "number",
                "missing": "unavailable"
              },
              "right": {
                "type": "literal",
                "value": 9
              }
            },
            "then": {
              "type": "literal",
              "value": "9+"
            }
          }
        ],
        "otherwise": {
          "type": "format",
          "pattern": "{count}",
          "args": {
            "count": {
              "type": "read",
              "from": {
                "type": "source",
                "sourceId": "temp",
                "path": [
                  "state"
                ]
              },
              "as": "number",
              "missing": "unavailable"
            }
          }
        }
      },
      "spoken": {
        "type": "format",
        "pattern": "{count} overdue",
        "args": {
          "count": {
            "type": "read",
            "from": {
              "type": "source",
              "sourceId": "temp",
              "path": [
                "state"
              ]
            },
            "as": "number",
            "missing": "unavailable"
          }
        }
      }
    }
  },
  "env": {
    "reads": {
      "temp/state": {
        "status": "value",
        "value": 4
      }
    }
  },
  "expected": {
    "status": "value",
    "text": "4",
    "spoken": "4 overdue"
  }
}
