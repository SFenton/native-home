{
  "format": 1,
  "name": "count-operand-state-is-unavailable-text",
  "note": "An entity that reports the state \"unavailable\" is a value that is not \"on\": not counted, and not a reason to stop counting.",
  "subject": {
    "operand": {
      "type": "count",
      "of": [
        {
          "test": {
            "type": "state",
            "sourceId": "a",
            "path": [
              "state"
            ],
            "in": [
              "on"
            ]
          }
        },
        {
          "test": {
            "type": "state",
            "sourceId": "b",
            "path": [
              "state"
            ],
            "in": [
              "on"
            ]
          }
        },
        {
          "test": {
            "type": "state",
            "sourceId": "c",
            "path": [
              "state"
            ],
            "in": [
              "on"
            ]
          }
        }
      ]
    }
  },
  "env": {
    "reads": {
      "a/state": {
        "status": "value",
        "value": "unavailable"
      },
      "b/state": {
        "status": "value",
        "value": "on"
      },
      "c/state": {
        "status": "value",
        "value": "off"
      }
    }
  },
  "expected": {
    "status": "value",
    "value": 1
  }
}
