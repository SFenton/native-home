{
  "format": 1,
  "name": "countdown-remaining-text-next-second",
  "note": "One second later the same line says 04:52.",
  "subject": {
    "operand": {
      "type": "format",
      "pattern": "{s}",
      "args": {
        "s": {
          "type": "date",
          "op": "seconds-between",
          "from": {
            "type": "clock",
            "part": "now-second"
          },
          "to": {
            "type": "read",
            "from": {
              "type": "source",
              "sourceId": "timer",
              "path": [
                "attributes",
                "finishes_at"
              ]
            },
            "as": "string",
            "missing": "unavailable"
          }
        }
      },
      "formats": {
        "s": {
          "duration": {
            "style": "clock"
          }
        }
      }
    }
  },
  "env": {
    "reads": {
      "timer/attributes/finishes_at": {
        "status": "value",
        "value": "2026-11-17T10:05:00+00:00"
      }
    },
    "clock": {
      "now": "2026-11-17T10:00:08",
      "utcOffsetMinutes": 0
    }
  },
  "expected": {
    "status": "value",
    "value": "04:52"
  }
}
