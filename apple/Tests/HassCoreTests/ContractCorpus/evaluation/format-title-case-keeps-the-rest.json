{
  "format": 1,
  "name": "format-title-case-keeps-the-rest",
  "note": "Only the first character of a word changes: \"AUTO\" stays \"AUTO\" and a space does not separate words, so \"heat cool\" is \"Heat cool\".",
  "subject": {
    "operand": {
      "type": "format",
      "pattern": "{a} {b}",
      "args": {
        "a": {
          "type": "literal",
          "value": "AUTO"
        },
        "b": {
          "type": "literal",
          "value": "heat cool"
        }
      },
      "formats": {
        "a": {
          "text": {
            "case": "title"
          }
        },
        "b": {
          "text": {
            "case": "title"
          }
        }
      }
    }
  },
  "env": {},
  "expected": {
    "status": "value",
    "value": "AUTO Heat cool"
  }
}
