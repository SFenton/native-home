{
  "format": 1,
  "name": "date-relative-clock-zone",
  "note": "Relative counts whole days on the clock: 03:00 UTC on the 16th is 19:00 on the 15th at -08:00, so Today.",
  "subject": {
    "operand": {
      "type": "format",
      "pattern": "{d}",
      "args": {
        "d": {
          "type": "literal",
          "value": "2026-11-16T03:00:00Z"
        }
      },
      "formats": {
        "d": {
          "date": {
            "style": "relative"
          }
        }
      }
    }
  },
  "env": {
    "locale": "en_US",
    "clock": {
      "now": "2026-11-15T09:30:00",
      "utcOffsetMinutes": -480
    }
  },
  "expected": {
    "status": "value",
    "value": "Today"
  }
}
