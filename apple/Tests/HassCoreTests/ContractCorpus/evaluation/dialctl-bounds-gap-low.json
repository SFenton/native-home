{
  "format": 1,
  "name": "dialctl-bounds-gap-low",
  "note": "A gap of 5 holds the low handle at 65, 5 short of the high one (70), and a stop mark stands there.",
  "subject": {
    "dialctl": {
      "op": "bounds",
      "input": {
        "range": {
          "min": 0,
          "max": 100,
          "step": 1
        },
        "stoppers": [
          {
            "id": "low",
            "value": 30
          },
          {
            "id": "high",
            "value": 70
          }
        ],
        "between": {
          "rule": "stop",
          "gap": 5
        }
      },
      "id": "low"
    }
  },
  "env": {},
  "expected": {
    "dialctl": {
      "bounds": {
        "lower": 0,
        "upper": 65,
        "lowerMark": null,
        "upperMark": 65
      }
    }
  }
}
