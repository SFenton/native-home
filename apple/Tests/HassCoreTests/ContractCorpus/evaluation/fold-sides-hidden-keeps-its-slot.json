{
  "format": 1,
  "name": "fold-sides-hidden-keeps-its-slot",
  "note": "A section a rule hides at run time keeps its slot, so the sections after it keep their sides.",
  "subject": {
    "foldsides": {
      "geometry": {
        "leading": 455.3,
        "band": 40.4,
        "trailing": 372.3
      },
      "inset": 16,
      "foldSides": "auto",
      "items": [
        {
          "id": "s1",
          "type": "section"
        },
        {
          "id": "s2",
          "type": "section",
          "hiddenByRule": true
        },
        {
          "id": "s3",
          "type": "section"
        }
      ]
    }
  },
  "env": {},
  "expected": {
    "foldsides": {
      "active": true,
      "sides": [
        {
          "id": "s1",
          "side": "leading",
          "width": 423.3
        },
        {
          "id": "s2",
          "side": "trailing",
          "width": 340.3
        },
        {
          "id": "s3",
          "side": "leading",
          "width": 423.3
        }
      ]
    }
  }
}
