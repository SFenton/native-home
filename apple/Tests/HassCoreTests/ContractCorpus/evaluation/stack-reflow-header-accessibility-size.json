{
  "format": 1,
  "name": "stack-reflow-header-accessibility-size",
  "note": "At an accessibility text size the header stacks however much room there is: the text size is the reason.",
  "subject": {
    "stack": {
      "props": {
        "axis": "horizontal",
        "spacing": {
          "type": "token",
          "name": "m"
        },
        "align": "center",
        "groups": [
          {
            "children": [
              "glyph",
              "condition",
              "range"
            ],
            "spacing": {
              "type": "token",
              "name": "xs"
            },
            "grow": true
          },
          {
            "children": [
              "numeral"
            ]
          }
        ],
        "collapse": {
          "to": "vertical",
          "when": [
            "accessibility-size",
            "overflow"
          ],
          "fits": [
            "range"
          ],
          "spacing": {
            "type": "token",
            "name": "s"
          },
          "groups": [
            {
              "children": [
                "glyph",
                "numeral"
              ],
              "distribution": "spread",
              "align": "center"
            },
            {
              "children": [
                "condition"
              ]
            },
            {
              "children": [
                "range"
              ]
            }
          ]
        }
      },
      "children": [
        {
          "id": "glyph",
          "width": 40
        },
        {
          "id": "condition",
          "width": 320,
          "shrinks": true
        },
        {
          "id": "range",
          "width": 110
        },
        {
          "id": "numeral",
          "width": 88
        }
      ],
      "width": 343,
      "accessibilitySize": true
    }
  },
  "env": {},
  "expected": {
    "stack": {
      "collapsed": true,
      "reason": "accessibility-size",
      "axis": "vertical",
      "spacing": 8,
      "groups": [
        {
          "children": [
            "glyph",
            "numeral"
          ],
          "spacing": 8,
          "distribution": "spread",
          "align": "center",
          "grow": false
        },
        {
          "children": [
            "condition"
          ],
          "spacing": 8,
          "distribution": "natural",
          "align": "start",
          "grow": false
        },
        {
          "children": [
            "range"
          ],
          "spacing": 8,
          "distribution": "natural",
          "align": "start",
          "grow": false
        }
      ]
    }
  }
}
