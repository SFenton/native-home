+# Test Home Assistant VM (App Review / CI demo house). Always called guarded
+# (|| log_warn) from the boot sequence so it can never abort the main boot.
+start_test_ha_vm() {
+    start_vm "$TEST_HA_VM_NAME" "Test Home Assistant"
+}
+
+stop_test_ha_vm() {
+    stop_vm "$TEST_HA_VM_NAME" "Test Home Assistant"
+}
+
