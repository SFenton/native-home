@@ -605,2 +616,5 @@
     virsh list --all | grep "$OPENCLAW_VM_NAME" || echo "VM not found"
+
+    echo -e "\n${YELLOW}=== Test Home Assistant VM ===${NC}"
+    virsh list --all | grep "$TEST_HA_VM_NAME" || echo "VM not found"
 }
