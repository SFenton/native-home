{
  "_about": "Edited by the owner. Read by tools/pr_text.py. Stems match at a word start and run to the end of the word (\"ensur\" matches ensure, ensured, ensuring). Patterns are Python regexes (case-sensitive unless they start with (?i)).",
  "banned_stems": [
    "leverag", "robust", "seamless", "comprehensive", "ensur", "utiliz", "facilitat",
    "streamlin", "enhanc", "holistic", "delv"
  ],
  "banned_phrases": ["in order to"],
  "internal_labels": [
    "\\bPhase \\d+",
    "\\b[Ll]anes? P\\d+\\w*",
    "\\bT-[A-Za-z0-9]+(?:-[A-Za-z0-9]+)*"
  ],
  "path_roots": [".agents", ".claude", ".github", "apple", "tools", "contracts", "evals", "build", "Sources"],
  "path_extensions": ["py", "sh", "md", "swift", "json", "yml", "yaml", "plist", "toml", "xcconfig"],
  "placeholder_strings": [
    "Two or three sentences for a person who never opens code",
    "the owner's words, one line",
    "open this on that device",
    "One hero pair: the device class",
    "Fill in once the pictures exist",
    "What and why, rung-0 note link",
    "Commands and results.",
    "The reviewer's summary is written between these markers",
    "L0, L1 or L2",
    "Unchanged, checked by [tests]",
    "TODO",
    "TBD",
    "Lorem ipsum"
  ],
  "marker_blocks": ["sh-status", "sh-devices", "sh-evidence", "sh-timeline", "review"],
  "irregular_participles": [
    "built", "made", "done", "given", "taken", "shown", "written", "sent", "kept", "held",
    "found", "seen", "known", "chosen", "broken", "hidden", "lost", "left", "run", "set"
  ],
  "progressive_allow": ["nothing", "something", "anything", "everything", "morning", "evening", "during", "being", "ceiling", "string", "king", "thing", "bring", "spring"],
  "areas": [
    ["apple/Sources/HassUI", "uikit"],
    ["apple/Apps/iOS", "uikit"],
    ["apple/Apps/iOSTests", "uikit"],
    ["apple/Apps/iOSUITests", "uikit"],
